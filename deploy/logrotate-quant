# /etc/logrotate.d/quant-dashboard
#
# Rotates every log under data/logs (autotrade.log of the service, the jobs' autotrade-jobs.log
# and autotrade-ai.log). Install:
#
#   sudo apt-get install -y logrotate            # not present by default here
#   sudo cp deploy/logrotate-quant /etc/logrotate.d/quant-dashboard
#   sudo chown ubuntu:ubuntu ~/quant-dashboard/data/logs/autotrade.log
#   sudo logrotate -d /etc/logrotate.d/quant-dashboard   # dry run
#
# One glob, not one block per file: a path may appear in only one stanza and
# autotrade.log is inside this directory like the rest.
#
# copytruncate, not create: systemd holds autotrade.log open with `append:`,
# so a rename would leave the service writing to an unlinked inode and the
# new file would stay empty until the next restart.
#
# `su ubuntu ubuntu` is required, not optional: data/logs is group-writable
# (drwxrwxr-x ubuntu ubuntu) and logrotate refuses a directory it does not
# consider secure unless told whose privileges to drop to. That makes ubuntu
# the one doing the truncating, which is why autotrade.log has to belong to
# ubuntu — systemd creates it as root, and copytruncate needs write access to
# the file itself. The chown holds: `append:` never re-creates an existing
# file, and copytruncate never unlinks one.
/home/ubuntu/quant-dashboard/data/logs/*.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su ubuntu ubuntu
}
