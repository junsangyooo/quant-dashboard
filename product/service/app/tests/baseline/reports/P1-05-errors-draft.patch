@@ -0,0 +1,66 @@
+"""앱 오류 종류 한 곳(ARCHITECTURE 2-1 · 6절 '오류' · QUALITY E6 · TASKS P1-05).
+
+오류는 **번호(`Code`) + 화면에 보여도 되는 글 + 값**만 가져요. HTTP 상태는 모르고, API(지금은 `main.py`의 예외 처리 ·
+P1-09 뒤 `api/`)가 번호 → HTTP 상태 표(`main.HTTP_STATUS`) 하나로 붙여요. 글에는 비밀 값을 넣지 않아요(S2).
+모듈마다 따로이던 종류(`ApiError` · `DataError` · `LiveError` · `PaperError` · `VaultError` · `TelegramError`)는 이름 그대로 여기
+있어요(화면에 나가는 응답 모양 · 상태가 전과 같게 · 예외 처리가 종류마다 다른 값을 붙여요).
+"""
+
+from __future__ import annotations
+
+from enum import StrEnum
+from typing import Any
+
+
+class Code(StrEnum):
+    """앱 오류 번호(HTTP를 모름)."""
+
+    INPUT = "input"  # 보낸 값이 맞지 않아요
+    LOGIN = "login"  # 로그인 · 비밀번호 · 복구 코드가 맞지 않아요
+    CONFIRM = "confirm"  # 비밀번호를 다시 받아야 해요(돈이 움직이는 일 · S5)
+    NOT_FOUND = "not_found"  # 그것이 없어요
+    CONFLICT = "conflict"  # 지금 상태에서는 할 수 없어요
+    FORMAT = "format"  # 보낸 형식(JSON)이 아니에요
+    LOCKED = "locked"  # 잠겨 있어요(비밀번호를 넣으면 다시)
+    TOO_MANY = "too_many"  # 너무 많이 틀렸어요(잠시 잠금)
+    BROKEN = "broken"  # 앱 안에 둔 값을 풀지 못했어요
+    UPSTREAM = "upstream"  # 바깥(토스 · 텔레그램 · 공인 IP)에 닿지 않아요
+    UNAVAILABLE = "unavailable"  # 지금은 할 수 없어요(준비 안 됨)
+
+
+class AppError(Exception):
+    """화면에 그대로 보여도 되는 글만 담아요(비밀 값 없음)."""
+
+    def __init__(self, message: str, code: Code = Code.INPUT, **extra: Any) -> None:
+        super().__init__(message)
+        self.message = message
+        self.code = code
+        self.extra = extra
+
+
+class ApiError(AppError):
+    """전략 API(`api_v2`)."""
+
+
+class DataError(AppError):
+    """백업 · 복원 · 자료 관리(`datamgmt`)."""
+
+
+class LiveError(AppError):
+    """실전 운용(`live`)."""
+
+
+class PaperError(AppError):
+    """모의투자(`paper_v2`)."""
+
+
+class VaultError(AppError):
+    """금고 · 세션 · 키 · 연결(`vault` · `connect` · 요청 읽기)."""
+
+
+class TelegramError(AppError):
+    """텔레그램 연결. kind: token · chat · send · locked(화면이 칸을 고를 때 씀)."""
+
+    def __init__(self, message: str, kind: str = "send", code: Code = Code.INPUT) -> None:
+        super().__init__(message, code)
+        self.kind = kind
