{
  "type": "object",
  "additionalProperties": false,
  "required": ["facts", "confirm", "invalidate", "valuation", "bear_case", "verdict", "conviction", "watch_next", "sell_conditions"],
  "properties": {
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value", "meaning"],
        "properties": {
          "key": {"type": "string", "maxLength": 80},
          "value": {"type": "number"},
          "meaning": {"type": "string", "maxLength": 140}
        }
      }
    },
    "confirm": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "status", "evidence"],
        "properties": {
          "condition": {"type": "string", "maxLength": 160},
          "status": {"enum": ["충족", "미충족", "모름"]},
          "evidence": {"type": "string", "maxLength": 200}
        }
      }
    },
    "invalidate": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "status", "evidence"],
        "properties": {
          "condition": {"type": "string", "maxLength": 160},
          "status": {"enum": ["걸림", "안 걸림", "모름"]},
          "evidence": {"type": "string", "maxLength": 200}
        }
      }
    },
    "valuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": {"enum": ["과열", "적정", "싸다"]},
        "evidence": {"type": "string", "maxLength": 240}
      }
    },
    "bear_case": {"type": "string", "maxLength": 240},
    "verdict": {"enum": ["유지", "약화", "반증"]},
    "conviction": {"enum": ["상", "중상", "중", "중하", "하"]},
    "watch_next": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 100}},
    "sell_conditions": {"type": "array", "minItems": 1, "maxItems": 6, "items": "__CONDITION__"}
  }
}
