{
  "type": "object",
  "additionalProperties": false,
  "required": ["metrics", "notes"],
  "properties": {
    "metrics": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "period", "value", "unit", "quote"],
        "properties": {
          "metric": {"enum": ["__METRICS__"]},
          "period": {"type": "string", "pattern": "^((FY)?[0-9]{4}Q[1-4]|[0-9]{4}-(0[1-9]|1[0-2])|FY[0-9]{4})$"},
          "value": {"type": "number"},
          "unit": {"enum": ["%", "KRW", "USD", "x", "count"]},
          "quote": {"type": "string", "maxLength": 300}
        }
      }
    },
    "notes": {"type": "string", "maxLength": 300}
  }
}
