.venv/
__pycache__/
*.pyc
.DS_Store
.env
STATUS.md

# ── Runtime data (written on the server, never in git) ───────────────
# autotrade.db with its -wal/-shm and locks, autotrade.secret, autotrade-toss/ (the tick's
# token cache), ai-cwd/, backup/, deploy/ (history.jsonl), logs/
data/

# ── Local-only folders ───────────────────────────────────────────────
docs/
tmp/

# ── Catch-all by extension (defense in depth) ───────────────────────
*.log
*.pid
*.parquet
*.csv

# ── web/ ─────────────────────────────────────────────────────────────
web/node_modules/
# On the server web/dist is a symlink to web/releases/<id> (deploy/deploy.sh): no trailing slash,
# or the link would not match.
web/dist
web/releases/
web/test-results/
web/playwright-report/
web/coverage/
